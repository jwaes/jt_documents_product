<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_document_form" model="ir.ui.view">
        <field name="name">product.document.form.doc_products</field>
        <field name="model">product.document</field>
        <field name="inherit_id" ref="sale.product_document_form"/>
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <field name="mail_attach_on_so" class="oe_inline"/>
            </group>
            <group name="sale" position="after">
                <group name="purchase" string="Purchase">
                    <field name="mail_attach_on_po" class="oe_inline"/>
                </group>
            </group>                                        
        </field>
    </record>

    <record id="product_document_kanban" model="ir.ui.view">
        <field name="name">product.document.kanban.doc_products</field>
        <field name="model">product.document</field>
        <field name="inherit_id" ref="product.product_document_kanban"/>
        <field name="arch" type="xml">
            <main position="inside">
                <div class="d-flex mt-2">
                    <span>Attach on Quotation / Sales Order</span>
                    <field name="mail_attach_on_so" class="ms-2" widget="boolean_toggle"/>
                </div>
                <div class="d-flex mt-2">
                    <span>Attach on RFQ / Purchase Order</span>
                    <field name="mail_attach_on_po" class="ms-2" widget="boolean_toggle"/>
                </div>                
            </main>
            <t t-name="menu" position="inside">
                <a type="object" name="action_goto_documents" class="dropdown-item">Go to Documents</a>
            </t>
        </field>
    </record>

    <record id="product_document_list" model="ir.ui.view">
        <field name="name">product.document.list.doc_products</field>
        <field name="model">product.document</field>
        <field name="inherit_id" ref="product.product_document_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="mail_attach_on_so"/>
                <field name="mail_attach_on_po"/>
            </field>
        </field>
    </record>
    
    <record id="product_document_search" model="ir.ui.view">
        <field name="name">product.document.search.doc_products</field>
        <field name="model">product.document</field>
        <field name="inherit_id" ref="product.product_document_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <separator/>
                <filter name="quotation"
                    string="Attach SO"
                    domain="[('mail_attach_on_so', '=', True)]"/>
                <filter name="sale_order"
                    string="Attach PO"
                    domain="[('mail_attach_on_po', '=', False)]"/>
            </search>
        </field>
    </record>    


</odoo>